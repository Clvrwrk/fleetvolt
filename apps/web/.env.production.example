# FleetVolt web — PRODUCTION env template (Vercel + Convex).
# Copy values into the Vercel dashboard (Settings → Environment Variables).
# Real values live in the Vercel dashboard or ~/.config/cleverwork/master.env —
# NEVER commit real keys to this repo.

# Google Maps JavaScript API — browser key, HTTP-referrer restricted.
# Referrer allowlist MUST include BOTH apex and subdomain forms:
#   https://fleetvolt.network/*
#   https://*.fleetvolt.network/*
# Note: `*.fleetvolt.network/*` does NOT match the apex host (RefererNotAllowedMapError).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-prod-maps-browser-key

# Vector Map ID (Google Cloud → Map Management, Rendering: Vector).
# Same Map ID as local dev — AdvancedMarkerElement + cloud styling require it.
NEXT_PUBLIC_GOOGLE_MAP_ID=your-vector-map-id

# Convex PRODUCTION deployment URL.
# Created via `npx convex deploy` — this is NOT the dev sensible-oriole-832 URL.
# Set this in Vercel as a browser-visible (NEXT_PUBLIC_) env var.
NEXT_PUBLIC_CONVEX_URL=https://your-prod-deployment.convex.cloud

# Convex deploy key for CI/CD pushes (server-side only, NOT browser-visible).
# Used by `npx convex deploy` in Vercel build or GitHub Actions.
# Obtain from Convex dashboard → Settings → Deploy Keys.
CONVEX_DEPLOY_KEY=your-convex-deploy-key
