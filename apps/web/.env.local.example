# FleetVolt web — local env template. Copy to .env.local and fill real values.
# .env.local is git-ignored (never commit real keys). Values live in the team secret store.

# Google Maps JavaScript API — browser key, HTTP-referrer restricted.
# Referrer allowlist: http://localhost:3000/*, http://127.0.0.1:3000/*,
#   https://fleetvolt.network/*, https://*.fleetvolt.network/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-browser-key

# Vector Map ID (created in Google Cloud → Map Management, Rendering: Vector).
# MANDATORY — AdvancedMarkerElement + cloud styling require a vector Map ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=your-vector-map-id

# Convex deployment client URL (from `npx convex dev`, e.g. https://<name>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deployment identifier (dev:<name>). Written by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment

# NOTE: Mapbox is fully retired as of Phase 11 (plan 11-03). mapbox-gl and
# react-map-gl are removed app-wide and NEXT_PUBLIC_MAPBOX_TOKEN is no longer
# used anywhere — all map surfaces now render on @vis.gl/react-google-maps.
