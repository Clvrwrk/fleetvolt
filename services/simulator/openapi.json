        ],
        "summary": "Get Truck",
        "operationId": "get_truck_v1_trucks__truck_id__get",
        "parameters": [
          {
            "name": "truck_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Truck Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
