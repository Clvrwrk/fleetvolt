            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "nameplate_kwh": {
            "type": "number",
            "title": "Nameplate Kwh"
          },
          "usable_kwh": {
            "type": "number",
            "title": "Usable Kwh"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "source_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Notes",
            "description": "Truncated OEM source notes (max 200 chars)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "nameplate_kwh",
          "usable_kwh"
        ],
        "title": "TruckConfigSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
