{
  "openapi": "3.1.0",
  "info": {
    "title": "FleetVolt Simulator",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/chargers/near": {
      "get": {
        "tags": [
          "chargers"
        ],
        "summary": "Chargers Near",
        "description": "Return chargers within radius of a point, sorted by distance.",
        "operationId": "chargers_near_v1_chargers_near_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Query latitude (WGS84)",
              "title": "Lat"
            },
            "description": "Query latitude (WGS84)"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Query longitude (WGS84)",
              "title": "Lon"
            },
            "description": "Query longitude (WGS84)"
          },
          {
            "name": "radius_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Search radius in meters",
              "default": 50000,
              "title": "Radius M"
            },
            "description": "Search radius in meters"
          },
          {
            "name": "hd_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Return only hd_capable chargers",
              "default": false,
              "title": "Hd Only"
            },
            "description": "Return only hd_capable chargers"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChargerNearResponse"
                  },
                  "title": "Response Chargers Near V1 Chargers Near Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/data/freshness": {
      "get": {
        "tags": [
          "chargers"
        ],
        "summary": "Data Freshness",
        "description": "Return freshness metadata for all ingested datasets.",
        "operationId": "data_freshness_v1_data_freshness_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DataFreshnessResponse"
                  },
                  "type": "array",
                  "title": "Response Data Freshness V1 Data Freshness Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/elevation/{corridor_key}": {
      "get": {
        "tags": [
          "elevation"
        ],
        "summary": "Get Elevation Profile",
        "description": "Return cached elevation profile metadata and preview for a corridor.",
        "operationId": "get_elevation_profile_v1_elevation__corridor_key__get",
        "parameters": [
          {
            "name": "corridor_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Corridor Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElevationProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/routing/route": {
      "get": {
        "tags": [
          "routing"
        ],
        "summary": "Get Route",
        "description": "Return a Class 8 truck route via Valhalla truck costing.",
        "operationId": "get_route_v1_routing_route_get",
        "parameters": [
          {
            "name": "origin_lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Origin latitude",
              "title": "Origin Lat"
            },
            "description": "Origin latitude"
          },
          {
            "name": "origin_lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Origin longitude",
              "title": "Origin Lon"
            },
            "description": "Origin longitude"
          },
          {
            "name": "dest_lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Destination latitude",
              "title": "Dest Lat"
            },
            "description": "Destination latitude"
          },
          {
            "name": "dest_lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Destination longitude",
              "title": "Dest Lon"
            },
            "description": "Destination longitude"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/spatial/nhfn/stats": {
      "get": {
        "tags": [
          "spatial"
        ],
        "summary": "Nhfn Stats",
        "operationId": "nhfn_stats_v1_spatial_nhfn_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
