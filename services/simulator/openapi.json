                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChargerNearResponse": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "power_kw": {
            "type": "number",
            "title": "Power Kw"
          },
          "hd_capable": {
            "type": "boolean",
            "title": "Hd Capable"
          },
          "operator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator"
          },
          "distance_m": {
            "type": "number",
            "title": "Distance M",
            "description": "Distance from query point in meters"
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "power_kw",
          "hd_capable",
          "distance_m"
        ],
        "title": "ChargerNearResponse"
      },
      "DataFreshnessResponse": {
        "properties": {
          "dataset_name": {
            "type": "string",
            "title": "Dataset Name"
          },
          "last_ingested_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Ingested At"
          },
          "row_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Row Count"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "dataset_name"
        ],
        "title": "DataFreshnessResponse"
      },
      "ElevationProfileResponse": {
        "properties": {
          "corridor_key": {
            "type": "string",
            "title": "Corridor Key"
          },
          "point_count": {
            "type": "integer",
            "title": "Point Count"
          },
          "max_grade_pct": {
            "type": "number",
            "title": "Max Grade Pct"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "profile_preview": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/ProfilePoint"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Profile Preview",
            "description": "First and last three profile points"
          }
        },
        "type": "object",
        "required": [
          "corridor_key",
          "point_count",
          "max_grade_pct",
          "profile_preview"
        ],
        "title": "ElevationProfileResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NhfnStatsResponse": {
        "properties": {
          "segment_count": {
            "type": "integer",
            "title": "Segment Count",
            "description": "Number of NHFN linework segments loaded"
          },
          "bbox_west": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox West",
            "description": "Western extent (degrees)"
          },
          "bbox_south": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox South",
            "description": "Southern extent (degrees)"
          },
          "bbox_east": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox East",
            "description": "Eastern extent (degrees)"
          },
          "bbox_north": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox North",
            "description": "Northern extent (degrees)"
          },
          "source_sample": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Sample",
            "description": "Example provenance source label"
          },
          "ingested_at_max": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingested At Max",
            "description": "Most recent ingest timestamp across NHFN rows"
          }
        },
        "type": "object",
        "required": [
          "segment_count"
        ],
        "title": "NhfnStatsResponse"
      },
      "ProfilePoint": {
        "properties": {
          "dist_m": {
            "type": "number",
            "title": "Dist M"
          },
          "elev_m": {
            "type": "number",
            "title": "Elev M"
          }
        },
        "type": "object",
        "required": [
          "dist_m",
          "elev_m"
        ],
        "title": "ProfilePoint"
      },
      "RouteResponse": {
        "properties": {
          "distance_m": {
            "type": "number",
            "title": "Distance M",
            "description": "Route length in meters"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S",
            "description": "Estimated travel time in seconds"
          },
          "encoded_polyline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encoded Polyline",
            "description": "Valhalla encoded polyline when shape_format is not geojson"
          },
          "coordinates": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Coordinates",
            "description": "GeoJSON [lon, lat] coordinate pairs along the route"
          },
          "valhalla_status": {
            "type": "string",
            "title": "Valhalla Status",
            "description": "Valhalla service status at request time"
          }
        },
        "type": "object",
        "required": [
          "distance_m",
          "duration_s",
          "valhalla_status"
        ],
        "title": "RouteResponse"
      },
      "StackMetaResponse": {
        "properties": {
          "postgres_version": {
            "type": "string",
            "title": "Postgres Version"
          },
          "table_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Table Counts",
            "description": "Row counts for core spatial tables"
          }
        },
        "type": "object",
        "required": [
          "postgres_version",
          "table_counts"
        ],
        "title": "StackMetaResponse"
      },
      "TruckConfigDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "source_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Notes"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "params"
        ],
        "title": "TruckConfigDetail"
      },
      "TruckConfigSummary": {
        "properties": {
