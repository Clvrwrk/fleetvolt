{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@fleetvolt/api#typecheck": {
      "dependsOn": ["^codegen", "^typecheck"]
    },
    "@fleetvolt/web#typecheck": {
      "dependsOn": ["^codegen", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "codegen": {
      "dependsOn": ["openapi:export"],
      "cache": true
    },
    "openapi:export": {
      "cache": false
    }
  }
}
