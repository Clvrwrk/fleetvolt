# FleetVolt local environment — copy to .env and adjust as needed

# PostgreSQL (Compose service: postgres)
POSTGRES_USER=fleetvolt
POSTGRES_PASSWORD=fleetvolt
POSTGRES_DB=fleetvolt
DATABASE_URL=postgresql+psycopg://fleetvolt:fleetvolt@localhost:5432/fleetvolt

# Service URLs (Compose internal DNS)
SIMULATOR_URL=http://simulator:8000
API_URL=http://api:4000

# Service ports (bind 0.0.0.0:$PORT per D-15)
PORT=3000
WEB_PORT=3000
API_PORT=4000
SIMULATOR_PORT=8000

# External data sources
NREL_API_KEY=
OPEN_ELEVATION_URL=https://api.open-elevation.com
